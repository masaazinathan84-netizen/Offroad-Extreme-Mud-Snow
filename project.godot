config_version=5

[application]
config/name="Offroad Extreme: Mud & Snow"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/description="Low-end Android off-road driving prototype"
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/window_width_override=960
window/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.43, 0.62, 0.72, 1)
